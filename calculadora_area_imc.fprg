<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Calculadora_IMC_e_Area_v2"/>
        <attribute name="authors" value="Assistant"/>
        <attribute name="about" value="Calculadora completa de IMC e Area com Quadrado para Flowgorithm"/>
        <attribute name="saved" value="2026-08-24 10:37:55 "/>
        <attribute name="created" value="RVJMQU5MVUlaRkVSUkVJUkFERVM7REYwMS1MQUIwNS00MjsyMDI2LTA4LTI0OyIxMDozMjo1OCAiOzM0Mzk="/>
        <attribute name="edited" value="RVJMQU5MVUlaRkVSUkVJUkFERVM7REYwMS1MQUIwNS00MjsyMDI2LTA4LTI0OyIxMDozNzo1NSAiOzE7MzU0OQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="opcao, tipoFigura" type="Integer" array="False" size=""/>
            <declare name="peso, altura, imc, pesoMin, pesoMax" type="Real" array="False" size=""/>
            <declare name="base, alturaArea, raio, lado, area" type="Real" array="False" size=""/>
            <output expression="&quot;Escreva a opcao desejada: 1 - para calculadora IMC / 2 - para calculadora de area&quot;" newline="True"/>
            <input variable="opcao"/>
            <if expression="opcao == 1">
                <then>
                    <output expression="&quot;Digite sua altura em metros:&quot;" newline="True"/>
                    <input variable="altura"/>
                    <output expression="&quot;Digite seu peso em Kg:&quot;" newline="True"/>
                    <input variable="peso"/>
                    <assign variable="imc" expression="peso / (altura * altura)"/>
                    <assign variable="pesoMin" expression="18.5 * (altura * altura)"/>
                    <assign variable="pesoMax" expression="24.9 * (altura * altura)"/>
                    <output expression="&quot;Seu IMC e: &quot; &amp; imc" newline="True"/>
                    <output expression="&quot;Seu peso ideal esta entre &quot; &amp; pesoMin &amp; &quot; kg e &quot; &amp; pesoMax &amp; &quot; kg.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Escolha a figura geometrica: 1 - Quadrado | 2 - Retangulo | 3 - Triangulo | 4 - Circulo&quot;" newline="True"/>
                    <input variable="tipoFigura"/>
                    <if expression="tipoFigura == 1">
                        <then>
                            <output expression="&quot;Digite o lado do quadrado:&quot;" newline="True"/>
                            <input variable="lado"/>
                            <assign variable="area" expression="lado * lado"/>
                            <output expression="&quot;A area do quadrado e: &quot; &amp; area" newline="True"/>
                        </then>
                        <else>
                            <if expression="tipoFigura == 2">
                                <then>
                                    <output expression="&quot;Digite a base do retangulo:&quot;" newline="True"/>
                                    <input variable="base"/>
                                    <output expression="&quot;Digite a altura do retangulo:&quot;" newline="True"/>
                                    <input variable="alturaArea"/>
                                    <assign variable="area" expression="base * alturaArea"/>
                                    <output expression="&quot;A area do retangulo e: &quot; &amp; area" newline="True"/>
                                </then>
                                <else>
                                    <if expression="tipoFigura == 3">
                                        <then>
                                            <output expression="&quot;Digite a base do triangulo:&quot;" newline="True"/>
                                            <input variable="base"/>
                                            <output expression="&quot;Digite a altura do triangulo:&quot;" newline="True"/>
                                            <input variable="alturaArea"/>
                                            <assign variable="area" expression="(base * alturaArea) / 2"/>
                                            <output expression="&quot;A area do triangulo e: &quot; &amp; area" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Digite o raio do circulo:&quot;" newline="True"/>
                                            <input variable="raio"/>
                                            <assign variable="area" expression="3.14159 * (raio ^ 2)"/>
                                            <output expression="&quot;A area do circulo e: &quot; &amp; area" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
